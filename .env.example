# ── CamAIvo — variables d'environnement ──────────────────────────
VITE_APP_NAME=CamAIvo

# Supabase (Phase 1)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Moteur de swap : mock | local | cloud
VITE_SWAP_MODE=mock
VITE_LOCAL_SWAP_WS=ws://127.0.0.1:8787
VITE_SIGNALING_WS=

# Paiements (Phase 5)
VITE_STRIPE_PUBLISHABLE_KEY=

# Support
VITE_SUPPORT_TELEGRAM=https://t.me/camaivo_support

# ── Côté serveur / Edge Functions (jamais exposé au client) ──────
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POINTS_PAR_MINUTE=20
